            const lang = document.getElementById('lang-select').value;
            const t = i18nData[lang];
            const couponsContainer = document.getElementById('inventory-coupons');
            const othersContainer = document.getElementById('inventory-others');
            
            couponsContainer.innerHTML = '';
            othersContainer.innerHTML = '';

            let hasCoupons = false;
            let hasOthers = false;

            for (const [prizeId, count] of Object.entries(exchangeCounts)) {
                if (count > 0) {
                    const category = prizeCategories[prizeId];
                    const prizeName = t[`${prizeId}Title`]; 
                    
                    const itemHTML = `
                        <div class="bg-white p-4 rounded shadow border-l-4 ${category === 'coupon' ? 'border-blue-500' : 'border-green-500'} flex justify-between items-center mb-3">
                            <span class="font-bold text-sm leading-tight pr-2">${prizeName}</span>
                            <span class="bg-gray-200 text-gray-800 text-xs px-2 py-1 rounded-full min-w-[60px] text-center whitespace-nowrap">${t.invOwn}${count}</span>
                        </div>
                    `;
                    if (category === 'coupon') {
                        couponsContainer.innerHTML += itemHTML;
                        hasCoupons = true;
                    } else {
                        othersContainer.innerHTML += itemHTML;
                        hasOthers = true;
                    }
                }
            }

            if (!hasCoupons) couponsContainer.innerHTML = `<p class="text-sm text-gray-500">${t.invEmptyCoupon}</p>`;
            if (!hasOthers) othersContainer.innerHTML = `<p class="text-sm text-gray-500">${t.invEmptyOther}</p>`;
