        <!-- 5. 獲得済み景品（持ち物）画面 -->
        <section id="tab-inventory" class="tab-content fade-in">
            <h2 class="text-2xl font-bold mb-4 border-b-2 border-blue-500 pb-2" data-i18n="invTitle">👜 獲得した景品</h2>
            
            <h3 class="font-bold text-lg mt-4 mb-2 text-blue-600" data-i18n="invCoupons">🎟️ クーポン</h3>
            <div id="inventory-coupons" class="space-y-3">
                <p class="text-sm text-gray-500" data-i18n="invEmptyCoupon">まだ獲得したクーポンはありません。</p>
            </div>
            
            <h3 class="font-bold text-lg mt-6 mb-2 text-green-600" data-i18n="invOthers">🎁 その他・デジタルコンテンツ</h3>
            <div id="inventory-others" class="space-y-3">
                <p class="text-sm text-gray-500" data-i18n="invEmptyOther">まだ獲得したその他の景品はありません。</p>
