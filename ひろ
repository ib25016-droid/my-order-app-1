    </main>

    <!-- ボトムナビゲーション -->
    <nav class="fixed bottom-0 w-full bg-white border-t border-gray-200 shadow-lg flex justify-around p-2 pb-safe z-50">
        <button onclick="switchTab('mission')" class="nav-btn flex flex-col items-center p-1 text-blue-600 w-1/5" data-target="mission">
            <span class="text-xl mb-1">📋</span><span class="text-[10px]" data-i18n="navMission">ミッション</span>
        </button>
        <button onclick="switchTab('qr')" class="nav-btn flex flex-col items-center p-1 text-gray-400 w-1/5" data-target="qr">
            <span class="text-xl mb-1">📷</span><span class="text-[10px]" data-i18n="navScan">スキャン</span>
        </button>
        <button onclick="switchTab('map')" class="nav-btn flex flex-col items-center p-1 text-gray-400 w-1/5" data-target="map">
            <span class="text-xl mb-1">🗺️</span><span class="text-[10px]" data-i18n="navMap">マップ</span>
        </button>
        <button onclick="switchTab('prize')" class="nav-btn flex flex-col items-center p-1 text-gray-400 w-1/5" data-target="prize">
            <span class="text-xl mb-1">🏆</span><span class="text-[10px]" data-i18n="navPrize">景品交換</span>
        </button>
        <button onclick="switchTab('inventory')" class="nav-btn flex flex-col items-center p-1 text-gray-400 w-1/5" data-target="inventory">
            <span class="text-xl mb-1">👜</span><span class="text-[10px]" data-i18n="navInventory">持ち物</span>
        </button>
    </nav>

    <!-- アプリのロジック (JavaScript) -->
    <script>
        // === 共通データ ===
        let currentPoints = 0;
        let qrScanner = null;
        const prizeLimits = { p1: 300, p2: 100, p3: 20, p4: 20, p5: Infinity, p6: Infinity, p7: Infinity, p8: Infinity };
        let exchangeCounts = { p1: 0, p2: 0, p3: 0, p4: 0, p5: 0, p6: 0, p7: 0, p8: 0 };
        const prizeCategories = { p1: 'coupon', p2: 'coupon', p3: 'other', p4: 'coupon', p5: 'other', p6: 'other', p7: 'other', p8: 'other' };

        // === お気に入りミッションデータ ===
        let favoritedSpots = [];
        let m1Cleared = false;
        const spotsData = [
            { id: 's1', ja: '鞆の浦 常夜燈', en: 'Joyato Lighthouse', zh: '鞆之浦 常夜灯' },
            { id: 's2', ja: '福禅寺 対潮楼', en: 'Fukuzenji Taichoro', zh: '福禅寺 对潮楼' },
            { id: 's3', ja: '仙酔島', en: 'Sensuijima Island', zh: '仙醉岛' },
            { id: 's4', ja: '太田家住宅', en: 'Ota Residence', zh: '太田家住宅' },
            { id: 's5', ja: 'いろは丸展示館', en: 'Irohamaru Museum', zh: '伊吕波丸展示馆' }
        ];

        // ページ読み込み時にスポットを描画
        document.addEventListener('DOMContentLoaded', () => {
            renderSpots();
        });

        // タブ切り替え
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.getElementById('tab-' + tabId).classList.add('active');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('text-blue-600');
                btn.classList.add('text-gray-400');
                if(btn.dataset.target === tabId) {
                    btn.classList.remove('text-gray-400');
                    btn.classList.add('text-blue-600');
                }
            });

            if(tabId === 'qr') { startQRScanner(); } else { stopQRScanner(); }
        }

        // ポイント追加
        function addPoints(pts) {
            currentPoints += pts;
            document.getElementById('point-display').innerText = currentPoints;
        }

        // QRスキャナー
        function startQRScanner() {
            if(!qrScanner) {
                qrScanner = new Html5QrcodeScanner("reader", { fps: 10, qrbox: 250, supportedScanTypes: [0] });
                qrScanner.render((decodedText) => {
                    addPoints(10);
                    const lang = document.getElementById('lang-select').value;
                    alert(i18nData[lang].alertSuccessScan.replace('{pts}', 10).replace('{total}', currentPoints));
                    stopQRScanner();
                    switchTab('mission');
                }, (error) => {});
            }
        }
        function stopQRScanner() {
            if(qrScanner) {
                qrScanner.clear().then(() => { qrScanner = null; }).catch(error => {});
            }
        }
        function simulateScan(pts) { 
            addPoints(pts);
            const lang = document.getElementById('lang-select').value;
            alert(i18nData[lang].alertSuccessScan.replace('{pts}', pts).replace('{total}', currentPoints));
        }

        // スポット描画 ＆ お気に入り機能
        function renderSpots() {
            const lang = document.getElementById('lang-select').value;
            const container = document.getElementById('spot-list');
            container.innerHTML = '';
            
            spotsData.forEach(spot => {
                const isFav = favoritedSpots.includes(spot.id);
                const heart = isFav ? '❤️' : '🤍';
                const name = spot[lang];
                
                container.innerHTML += `
                    <div class="bg-white p-3 rounded shadow flex justify-between items-center transition-colors ${isFav ? 'bg-red-50' : ''}">
                        <span class="font-bold text-sm text-gray-800">${name}</span>
                        <button onclick="toggleFavorite('${spot.id}')" class="text-2xl px-2 active:scale-125 transition-transform drop-shadow-sm cursor-pointer">${heart}</button>
                    </div>
                `;
            });
            updateMissionProgress(lang);
        }

        function toggleFavorite(spotId) {
            if (favoritedSpots.includes(spotId)) {
                favoritedSpots = favoritedSpots.filter(id => id !== spotId);
            } else {
                favoritedSpots.push(spotId);
            }
            renderSpots();
            checkMissions();
        }

        function checkMissions() {
            if (!m1Cleared && favoritedSpots.length >= 3) {
                m1Cleared = true;
                const lang = document.getElementById('lang-select').value;
                const t = i18nData[lang];
                
                // 少し遅延させてアラート表示（UIの更新を先に見せるため）
                setTimeout(() => {
                    alert(t.alertMissionClear);
                    addPoints(50);
                    renderSpots(); // ミッションUIを「達成済み」に更新
                }, 300);
            }
        }

        function updateMissionProgress(lang) {
            const t = i18nData[lang];
            const m1Card = document.getElementById('m1-card');
            const m1Status = document.getElementById('m1-status');
            const m1Progress = document.getElementById('m1-progress');

            if (m1Cleared) {
                m1Card.classList.remove('border-red-500');
                m1Card.classList.add('border-gray-400', 'bg-gray-100', 'opacity-70');
                m1Status.innerHTML = `<span class="text-gray-500">${t.cleared}</span>`;
                m1Progress.innerHTML = `<span class="text-gray-500">${t.favProgress.replace('{count}', favoritedSpots.length)}</span>`;
                m1Progress.classList.replace('bg-blue-50', 'bg-gray-200');
                m1Progress.classList.replace('text-blue-600', 'text-gray-500');
            } else {
                m1Progress.innerHTML = t.favProgress.replace('{count}', favoritedSpots.length);
            }
        }

        // 景品交換機能
        function exchangePrize(prizeId, cost) {
            const lang = document.getElementById('lang-select').value;
            const t = i18nData[lang];
            const prizeName = t[`${prizeId}Title`]; 
            
            if (exchangeCounts[prizeId] >= prizeLimits[prizeId]) {
                alert(t.alertLimit.replace('{prize}', prizeName));
                return; 
            }
            if (currentPoints >= cost) {
                if (confirm(t.alertConfirm.replace('{prize}', prizeName).replace('{cost}', cost))) {
                    currentPoints -= cost;
                    exchangeCounts[prizeId]++; 
                    document.getElementById('point-display').innerText = currentPoints;
                    alert(t.alertRedeemed.replace('{prize}', prizeName));
                    renderInventory();
                }
            } else {
                alert(t.alertFail.replace('{diff}', cost - currentPoints));
            }
        }

        // 持ち物画面描画
